<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="pricefilter"
        name="Filtre superficie"
        inherit_id="website_sale.products_attributes"
        active="False"
        customize_show="True"
        priority="10"
    >
        <xpath expr="//form[hasclass('js_attributes')]/ul" position="before">
            <div class="nav-item mb-4">
                <div>
                    <strong style="background-color:#243742; color:#ffffff">Filtre superficie</strong>
                </div>
                <div class="form_class price_filter_main js_attribute_filter_price">
                    <div class="row">
                        <div class="col-12">
                           
                        </div>
                    </div>
                    <div class="d-flex d-flex-row mt-1">
                        <div class="input-group input-group-sm mr-2">
                            <div class="input-group-prepend" t-if="website.currency_id.position == 'before'">
                                <span
                                    id="currency_simbol_from"
                                    class="input-group-text"
                                   
                                />
                            </div>
                            <input
                                type="text"
                                name="min_price_superficie"
                                t-att-value="custom_min_price_superficie"
                                placeholder="Superficie min"
                                id="price_range_min_value"
                                onpaste="return false"
                                class="form-control"
                            />
                            <div class="input-group-append" t-if="website.currency_id.position == 'after'">
                                <span
                                    id="currency_simbol_from"
                                    class="input-group-text"
                                   
                                />
                            </div>
                        </div>
                        <div class="input-group input-group-sm ml-2">
                            <div class="input-group-prepend" t-if="website.currency_id.position == 'before'">
                                <span
                                    id="currency_simbol_from"
                                    class="input-group-text"
                                   
                                />
                            </div>
                            <input
                                type="text"
                                name="max_price_superficie"
                                t-att-value="custom_max_price_superficie"
                                placeholder="Superficie max"
                                id="price_range_max_value"
                                onpaste="return false"
                                class="form-control"
                            />
                            <div class="input-group-append" t-if="website.currency_id.position == 'after'">
                                <span
                                    id="currency_simbol_from"
                                    class="input-group-text"
                                  
                                />
                            </div>
                        </div>
                    </div>
                    <div class="row mt-1">
                        <div class="col-auto ml-auto">
                            <div class="btn-group" role="group">
                                <input type="submit" class="btn btn-sm btn-default" value="Apply"/>
                                <button id="clear_price_filter" type="button" class="btn btn-sm btn-default" title="Reset Filter"><i class="fa fa-eraser"/></button>
                            </div>
                             <t t-if="custom_max_price_superficie">
                            <a role="menuitem" rel="noindex,nofollow" t-att-href="keep_superficie('/shop', order='superficie_site asc')" class="dropdown-item" style="color: #007bff;">
                                <span>Superficie: trier par ordre croissant</span>
                            </a>
                           </t>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
