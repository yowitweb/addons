<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="product_location_map" inherit_id="website_sale.product">
          <xpath expr="//div[@itemscope='itemscope']" position="after">
            
            <div class="panel panel-default" t-if="product.location">
                <div class="panel-heading oe_inline">
                    <span>Location :</span>
                    <span t-if="product.location.name" t-field="product.location.name"/>
                    <span t-if="product.location.name2" >, <span t-field="product.location.name2"/></span>
                    <span t-if="product.location.city">, <span t-field="product.location.city"/></span>
                    <span t-if="product.location.state_id">, <span t-field="product.location.state_id"/></span>
                    <span t-if="product.location.country_id">, <span t-field="product.location.country_id"/></span>
                    <span t-if="product.location.zip">, <span t-field="product.location.zip"/></span>
                    <span t-if="product.location.phone">, <span t-field="product.location.phone"/></span>
                </div>
                <div>
                    <t t-if="product.google_map_img()">
                        <a t-att-href="product.google_map_link()" target="_BLANK">
                           <img t-att-src="product.google_map_img()" width="100%%" height="100"/>
                        </a>
                    </t>
                    <t t-else="1">
                        <a style="color:#5D8DA8" t-att-href="product.google_map_link()" target="_BLANK">Visualize on Google Maps</a>
                    </t>
                </div>
            </div>
                
        </xpath>
    </template>    
</odoo>
