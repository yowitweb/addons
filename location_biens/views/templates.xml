    <template id="create_patient" name="Create Patient">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure">
                    <div class="container">
                        <form role="form" action="/create/webpatient" method="POST">
                           
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                             <div class="form-group">
                                <label for="name" class="control-label">Name</label>
                                <input type="text" name="name" t-att-value="name" id="name"
                                       class="form-control" placeholder="e.g. John Doe" required="required"/>
                            </div>
                            <div class="form-group">
                                <label for="email_from" class="control-label">Email</label>
                                <input type="email_from" name="email_from" t-att-value="email_from" id="email_from"
                                       class="form-control" required="required"/>
                            </div>
                            
                             <div class="form-group">
                                <label for="phone" class="control-label">tel</label>
                                <input type="phone" name="phone" t-att-value="phone" id="phone"
                                       class="form-control" required="required"/>
                            </div>
                            
                            <div class="clearfix oe_login_buttons">
                                <button type="submit" class="btn btn-primary pull-left">Create</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>
    
    
    
     <record id="patient_thanks" model="website.page">
        <field name="name">Thanks</field>
        <field name="type">qweb</field>
        <field name="url">/patient-thank-you</field>
        <field name="website_published">True</field>
        <field name="key">lb.location</field>
        <field name="arch" type="xml">
            <t name="Thanks" t-name="lb.location">
                <t t-call="website.layout">
                  <div id="wrap">
                    <div class="container">
                        <h1>Thanks!</h1>
                        <div class="row">
                            <div class="col-lg-8">
                                <div class="alert alert-success" role="status">
                                    The Patient has been Created successfully.
                                </div>
                                <p>
                                    Visit Hospital At ANy Time
                                </p>
                            </div>
                        </div>
                    </div>
                  </div>
                </t>
            </t>
        </field>
    </record>




    
    
    
